{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated dairy center user profile with server-enforced role.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "displayName": { "type": "string", "description": "Display name" },
        "role": { "type": "string", "enum": ["ADMIN", "OPERATOR", "STAFF"] },
        "stationId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "photoUrl": { "type": "string" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "email", "displayName", "role", "stationId", "isActive", "createdAt", "updatedAt"]
    },
    "Farmer": {
      "title": "Farmer",
      "description": "Registered milk supplier profile with bank details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "farmerId": { "type": "string" },
        "fullName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "villageAddress": { "type": "string" },
        "milkCategory": { "type": "string", "enum": ["COW", "BUFFALO"] },
        "photoUrl": { "type": "string" },
        "bankName": { "type": "string" },
        "accountHolderName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ifscCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "farmerId", "fullName", "mobileNumber", "milkCategory", "createdAt", "updatedAt"]
    },
    "MilkCollection": {
      "title": "MilkCollection",
      "description": "Milk collection entry synced from analyzer OCR or manual entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "date": { "type": "string" },
        "shift": { "type": "string", "enum": ["MORNING", "EVENING"] },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "milkCategory": { "type": "string", "enum": ["COW", "BUFFALO"] },
        "quantity": { "type": "number" },
        "fat": { "type": "number" },
        "snf": { "type": "number" },
        "waterPercentage": { "type": "number" },
        "rate": { "type": "number" },
        "totalAmount": { "type": "number" },
        "machineAmount": { "type": "number" },
        "scannedImageUrl": { "type": "string" },
        "ocrScanned": { "type": "boolean" },
        "ocrConfidence": { "type": "integer" },
        "machineNumber": { "type": "string" },
        "actualTime": { "type": "string" },
        "transactionId": { "type": "string" },
        "scanRecordId": { "type": "string" },
        "verifiedBy": { "type": "string" },
        "month": { "type": "integer" },
        "year": { "type": "integer" },
        "sourceType": { "type": "string" },
        "verificationStatus": { "type": "string" },
        "timestampMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "receiptNumber", "date", "shift", "farmerId", "farmerName", "milkCategory", "quantity", "fat", "snf", "rate", "totalAmount", "createdAt", "updatedAt"]
    },
    "MilkRate": {
      "title": "MilkRate",
      "description": "Fat/SNF milk pricing formula configuration per category.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "category": { "type": "string", "enum": ["COW", "BUFFALO"] },
        "baseRate": { "type": "number" },
        "baseFat": { "type": "number" },
        "fatMultiplier": { "type": "number" },
        "baseSnf": { "type": "number" },
        "snfMultiplier": { "type": "number" },
        "waterDeductionPerPercent": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "category", "baseRate", "baseFat", "fatMultiplier", "baseSnf", "snfMultiplier", "waterDeductionPerPercent", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Farmer payment and ledger settlement transaction.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "transactionId": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "paymentAmount": { "type": "number" },
        "paymentDate": { "type": "string" },
        "paymentMode": { "type": "string", "enum": ["CASH", "UPI", "BANK TRANSFER"] },
        "paymentType": { "type": "string", "enum": ["WEEKLY", "ADVANCE", "PARTIAL", "FULL"] },
        "note": { "type": "string" },
        "previousBalance": { "type": "number" },
        "finalBalance": { "type": "number" },
        "timestampMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "transactionId", "farmerId", "farmerName", "paymentAmount", "paymentDate", "paymentMode", "paymentType", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operational dairy center expense record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "expenseId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["ELECTRICITY", "SALARY", "MAINTENANCE", "CATTLE_FEED", "OTHER"] },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMode": { "type": "string", "enum": ["CASH", "UPI", "BANK TRANSFER"] },
        "note": { "type": "string" },
        "recordedBy": { "type": "string" },
        "timestampMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "expenseId", "title", "category", "amount", "date", "paymentMode", "createdAt", "updatedAt"]
    },
    "DailyReport": {
      "title": "DailyReport",
      "description": "Aggregated daily dairy collection, payment and expense totals.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "date": { "type": "string" },
        "totalWeight": { "type": "number" },
        "totalAmount": { "type": "number" },
        "morningWeight": { "type": "number" },
        "eveningWeight": { "type": "number" },
        "avgFat": { "type": "number" },
        "avgSnf": { "type": "number" },
        "entriesCount": { "type": "integer" },
        "totalPaid": { "type": "number" },
        "totalExpenses": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "date", "totalWeight", "totalAmount", "entriesCount", "createdAt", "updatedAt"]
    },
    "MonthlyReport": {
      "title": "MonthlyReport",
      "description": "Aggregated monthly dairy collection, cow/buffalo split, payment and expense totals.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "yearMonth": { "type": "string" },
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "totalWeight": { "type": "number" },
        "totalAmount": { "type": "number" },
        "cowWeight": { "type": "number" },
        "buffaloWeight": { "type": "number" },
        "entriesCount": { "type": "integer" },
        "totalPaid": { "type": "number" },
        "totalExpenses": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "yearMonth", "year", "month", "totalWeight", "totalAmount", "entriesCount", "createdAt", "updatedAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Station profile and morning/evening shift schedule configuration.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "dairyName": { "type": "string" },
        "centerName": { "type": "string" },
        "address": { "type": "string" },
        "contactNumber": { "type": "string" },
        "morningStartHour": { "type": "integer" },
        "morningStartMinute": { "type": "integer" },
        "morningEndHour": { "type": "integer" },
        "morningEndMinute": { "type": "integer" },
        "eveningStartHour": { "type": "integer" },
        "eveningStartMinute": { "type": "integer" },
        "eveningEndHour": { "type": "integer" },
        "eveningEndMinute": { "type": "integer" },
        "amountToleranceRs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "dairyName", "centerName", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app synced operational notification for payments, expenses, rate updates and OCR reviews.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "notificationId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "timestampMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "stationId", "notificationId", "title", "message", "type", "read", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/Users/{docId}": { "schema": { "$ref": "#/entities/User" }, "description": "Authenticated user profiles & roles" },
    "/Farmers/{docId}": { "schema": { "$ref": "#/entities/Farmer" }, "description": "Registered farmers per user/center" },
    "/MilkCollection/{docId}": { "schema": { "$ref": "#/entities/MilkCollection" }, "description": "All milk collection records" },
    "/MorningShift/{docId}": { "schema": { "$ref": "#/entities/MilkCollection" }, "description": "Morning shift collection records" },
    "/EveningShift/{docId}": { "schema": { "$ref": "#/entities/MilkCollection" }, "description": "Evening shift collection records" },
    "/MilkRates/{docId}": { "schema": { "$ref": "#/entities/MilkRate" }, "description": "Cow & Buffalo milk rate charts" },
    "/Payments/{docId}": { "schema": { "$ref": "#/entities/Payment" }, "description": "Farmer payment transactions" },
    "/Expenses/{docId}": { "schema": { "$ref": "#/entities/Expense" }, "description": "Dairy operational expenses" },
    "/DailyReports/{docId}": { "schema": { "$ref": "#/entities/DailyReport" }, "description": "Daily collection & financial summaries" },
    "/MonthlyReports/{docId}": { "schema": { "$ref": "#/entities/MonthlyReport" }, "description": "Monthly collection & financial summaries" },
    "/Settings/{docId}": { "schema": { "$ref": "#/entities/Setting" }, "description": "Dairy center and shift settings" },
    "/Notifications/{docId}": { "schema": { "$ref": "#/entities/Notification" }, "description": "Real-time notifications" }
  }
}
